      "title": "Throughput \u2014 Requests per Second (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(promhttp_metric_handler_requests_total{job=~\".*-service\"}[30s])) by (job)",
          "legendFormat": "{{job}} RPS",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(opencensus_io_http_server_request_count[1m]))",
          "legendFormat": "KrakenD Inbound RPS",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
