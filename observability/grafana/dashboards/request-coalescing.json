      "title": "Gateway & Service Latency (Average)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(opencensus_io_http_client_roundtrip_latency_sum[1m])) by (http_client_host) / sum(rate(opencensus_io_http_client_roundtrip_latency_count[1m])) by (http_client_host)",
          "legendFormat": "{{http_client_host}} (Backend)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(opencensus_io_http_server_latency_sum[1m])) / sum(rate(opencensus_io_http_server_latency_count[1m]))",
          "legendFormat": "KrakenD (Gateway)",
          "refId": "B"
        }
      ]
