        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Throughput — Requests per Second (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(promhttp_metric_handler_requests_total[30s])) by (job)",
          "legendFormat": "{{job}} RPS",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(krakend_router_connected_total[30s]))",
          "legendFormat": "KrakenD Inbound RPS",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
