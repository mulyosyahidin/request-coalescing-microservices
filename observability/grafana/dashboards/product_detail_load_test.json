  "panels": [
    {
      "title": "K6 Request Rate (Throughput)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(k6_http_reqs_total[$__rate_interval])",
          "legendFormat": "Req/s"
        }
      ]
    },
    {
      "title": "K6 Request Duration (Latency p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "k6_http_req_duration_p99",
          "legendFormat": "p99 Latency (ms)"
        }
      ]
    },
    {
      "title": "Database Queries (Product Service)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(product_db_queries_total{operation=\"select_one\"}[$__rate_interval]))",
          "legendFormat": "DB Query (select_one)"
        }
      ]
    },
    {
      "title": "API Gateway Load (KrakenD)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(opencensus_io_http_server_request_count[$__rate_interval]))",
          "legendFormat": "KrakenD requests"
        }
      ]
    }
  ],
  "refresh": "5s",
