# ==============================================================================
# Environment Variables Template - RequestCoalescing Project
# Copy file ini ke .env untuk konfigurasi lokal:
#   cp .env.example .env
# ==============================================================================

# --- Global / Environment ---
ENVIRONMENT=development
LOG_LEVEL=info
APP_PORT=8080

# --- Security / JWT ---
JWT_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars

# --- API Gateway (KrakenD) ---
KRAKEND_PORT=8080

# --- Databases (PostgreSQL) ---
# Auth DB
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password_secure
AUTH_DB_NAME=auth_db
AUTH_DB_PORT=5433
AUTH_DATABASE_URL=postgres://auth_user:auth_password_secure@auth-db:5432/auth_db?sslmode=disable

# Product DB
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product_password_secure
PRODUCT_DB_NAME=product_db
PRODUCT_DB_PORT=5434
PRODUCT_DATABASE_URL=postgres://product_user:product_password_secure@product-db:5432/product_db?sslmode=disable

# Order DB
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password_secure
ORDER_DB_NAME=order_db
ORDER_DB_PORT=5435
ORDER_DATABASE_URL=postgres://order_user:order_password_secure@order-db:5432/order_db?sslmode=disable

# --- Microservices Host Mapping & Inter-Service URLs ---
AUTH_SERVICE_HOST_PORT=8081
PRODUCT_SERVICE_HOST_PORT=8082
ORDER_SERVICE_HOST_PORT=8083

PRODUCT_SERVICE_URL=http://product-service:8080
AUTH_SERVICE_URL=http://auth-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080

# --- Observability Stack ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure
GRAFANA_HOST_PORT=3000

PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
ALLOY_HOST_PORT=12345

# --- AWS S3 Storage (Product Photos) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name

S3_BASE_URL=https://your-bucket.s3.amazonaws.com
