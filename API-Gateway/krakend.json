{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "RequestCoalescing API Gateway",
  "port": 8080,
  "cache_ttl": "300s",
  "timeout": "3000ms",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/gateway-health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/products",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "PUT",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "DELETE",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "encoding": "no-op",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "encoding": "json",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{id}",
          "encoding": "json",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}/status",
      "method": "PATCH",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{id}/status",
          "encoding": "no-op",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    }
  ]
}
