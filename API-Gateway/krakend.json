{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "RequestCoalescing API Gateway",
  "port": 8080,
  "cache_ttl": "300s",
  "timeout": "3000ms",
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "telemetry/metrics": {
      "endpoint": "/__stats/",
      "collection_time": "5s"
    },
    "telemetry/opencensus": {
      "sample_rate": 100,
      "reporting_period": 1,
      "exporters": {
        "prometheus": {
          "port": 9091,
          "tag_host": true,
          "tag_path": true,
          "tag_method": true,
          "tag_status": true
        }
      }
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:8089",
        "http://localhost:3000",
        "http://127.0.0.1:8089",
        "http://127.0.0.1:3000",
        "*"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "*"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "allow_credentials": false,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/gateway-health",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/register",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/logout",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/logout",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/me",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/me",
          "encoding": "no-op",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products",
      "method": "GET",
      "input_headers": [
        "*"
      ],
      "input_query_strings": [
        "*"
      ],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/products",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}/coalesced",
      "method": "GET",
      "input_headers": [
        "*"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}/coalesced",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "GET",
      "input_headers": [
        "*"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/upload",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/upload",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "PUT",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "DELETE",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "encoding": "no-op",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "encoding": "no-op",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "encoding": "json",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{id}",
          "encoding": "json",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}/status",
      "method": "PATCH",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{id}/status",
          "encoding": "no-op",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/welcome/auth",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "json",
          "host": [
            "http://auth-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/welcome/product",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "json",
          "host": [
            "http://product-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/welcome/order",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "json",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    }
  ]
}
